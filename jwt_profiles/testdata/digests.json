    {"name": "empty body", "body": "", "digest": "sha-256=:47DEQpj8HBSa+/TImW+5JCeuQeRkm5NMpJWZG3hSuFU=:"},
    {"name": "JSON body", "body": "{\"hpke_public_key\":\"BAAA\"}", "digest": "sha-256=:1TqsKT1i2AnulMV4Wwvu2M6UTKbhZ/d89IcwFUW9/cU=:"},
    {"name": "RFC 9530 Section 2 example", "body": "{\"hello\": \"world\"}", "digest": "sha-256=:X48E9qOokqqrvdts8nOJRJN3OWDUoyWxBf7kbu9DBPE=:"}
  ],
