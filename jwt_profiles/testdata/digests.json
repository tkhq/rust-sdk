    {"name": "inner whitespace is kept", "header": "x-note", "received": [["x-note", "a  \tb"]], "value": "a  \tb", "digest": "sha-256=:wQNtSxm9wAKM0erDbqd7c+HdGA8nVhcvOpW9YF5riSU=:"},
